root = true

[*]
# Line endings: LF everywhere (tellurian-review, "Repository hygiene"); see .gitattributes.
end_of_line = lf
charset = utf-8
indent_style = space

[*.{csproj,props,targets,slnx,xml,json,yml}]
indent_size = 2

[*.cs]
indent_size = 4
tab_width = 4
insert_final_newline = false

#### Code style enforced in build ####
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = true:warning
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = true:warning
csharp_new_line_before_open_brace = all
csharp_prefer_braces = when_multiline
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_prefer_collection_expression = when_types_loosely_match
csharp_using_directive_placement = outside_namespace
dotnet_sort_system_directives_first = false

#### Analyzer rules ####

# C# 14 `extension(...)` blocks are compiled as nested types, which the analyzer reports as
# publicly visible nested types (CA1034) and as members whose names collide (CA1708). They are the
# library's idiom for extension members, so both are noise.
dotnet_diagnostic.CA1034.severity = none
dotnet_diagnostic.CA1708.severity = none

# The text corrections lower-case names and words for display ("Cst", "von", "och"); nothing is
# normalised for comparison, which is what CA1308 guards against.
dotnet_diagnostic.CA1308.severity = none

[Tellurian.Utilities.Tests/**.cs]
# MSTest runs without a synchronisation context.
dotnet_diagnostic.CA2007.severity = none
# Test names read Method_Scenario_Expectation.
dotnet_diagnostic.CA1707.severity = none
# MSTest discovers test classes only when they are public.
dotnet_diagnostic.CA1515.severity = none
# Test data arrays are built inline so that each test shows its own input.
dotnet_diagnostic.CA1861.severity = none
# Data-driven test parameters come from the attributes beside them, never from callers.
dotnet_diagnostic.CA1062.severity = none
# Short-lived fixtures; the process ends with the test run.
dotnet_diagnostic.CA2000.severity = none
# Tests read data records through IDataRecord on purpose, to reach the extensions and not the BCL ones on DbDataReader.
dotnet_diagnostic.CA1859.severity = none
